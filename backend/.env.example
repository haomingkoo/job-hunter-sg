# Database (SQLite for local, PostgreSQL on Railway)
DATABASE_URL=sqlite:///./jobhunter.db

# JWT Secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-random-secret-in-production

# Resume-agent OpenTelemetry: none (default), console (local), or otlp.
OTEL_TRACES_EXPORTER=none
OTEL_SERVICE_NAME=job-hunter-sg
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Resume-agent deployment canary and concurrency limits.
AGENT_MAX_ACTIVE_RUNS=4
AGENT_E2E_REQUEST_TIMEOUT_SECONDS=30
AGENT_E2E_POLL_INTERVAL_SECONDS=2
AGENT_E2E_TERMINAL_TIMEOUT_SECONDS=300
AGENT_SSE_HEARTBEAT_SECONDS=15
# Request limits are named in backend/config.py and may be overridden there via env.

# Server
PORT=8000
APP_ENV=development

# Authentication: password accounts by default. Cloudflare Access is optional.
AUTH_MODE=password
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-audience
# CF_ACCESS_LOGIN_URL=https://job.example.com/cdn-cgi/access/login
# CF_ACCESS_LOGOUT_URL=https://job.example.com/cdn-cgi/access/logout

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Allow all valid email addresses to sign up.
ALLOWED_EMAIL_DOMAINS=*

# Admin account (auto-created on startup if set)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# Contact email shown in privacy notice
# CONTACT_EMAIL=support@jobhuntersg.com

# Matched job alert emails (scheduled command: python send_job_alerts.py)
# APP_BASE_URL=https://job.kooexperience.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=Job Hunter SG
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# AI rate limits (per day)
ANONYMOUS_AI_PER_DAY=3
ACCOUNT_AI_PER_DAY=500
RECRUITMENT_MODEL_HTTP_TIMEOUT_SECONDS=120
RECRUITMENT_MODEL_TRANSPORT_RETRIES=0
RECRUITMENT_SPECIALIST_VALIDATION_ATTEMPTS=2
RECRUITMENT_SPECIALIST_MAX_CONCURRENCY=5
RECRUITMENT_JUDGE_VALIDATION_ATTEMPTS=2
RECRUITMENT_SYNTHESIS_VALIDATION_ATTEMPTS=2
RECRUITMENT_MAX_SYNTHESIS_CORRECTIONS=1
CANDIDATE_PROFILE_VALIDATION_ATTEMPTS=2
CANDIDATE_PROFILE_EVALUATION_ATTEMPTS=2
RECRUITMENT_CONVERSATION_VALIDATION_ATTEMPTS=2
ROLE_DEFINITION_VALIDATION_ATTEMPTS=2
ROLE_EVIDENCE_VALIDATION_ATTEMPTS=2
RECRUITMENT_PERSONA_PACK_VERSION=v1
AGENT_PERSONA_VALIDATION_ATTEMPTS=2
AGENT_JUDGE_VALIDATION_ATTEMPTS=2

# SSG Skills Framework (register at developer.ssg-wsg.sg)
# skillsfuture_clientid=YOUR_CLIENT_ID
# skillsfuture_secret=YOUR_SECRET

# SEA-LION AI (free at sea-lion.ai — 10 req/min per key)
# sealion_api=YOUR_KEY
# sealion_api2=YOUR_KEY2
# Opt in to backend/tests/test_resume_agent_live.py
# RUN_LIVE_SEALION=1

# Adzuna API (free tier at developer.adzuna.com)
# ADZUNA_APP_ID=your_app_id
# ADZUNA_APP_KEY=your_app_key

# Jooble API (free at jooble.org/api/about)
# JOOBLE_API_KEY=your_api_key

# ACRA SSIC company taxonomy
# Default is cache-only to avoid slowing user-facing searches with public API calls.
# Local: python backfill_company_ssic.py --limit 200 --live --delay 8
# Railway: railway ssh python backfill_company_ssic.py --limit 200 --live --delay 8
# COMPANY_SSIC_CACHE_PATH=/absolute/path/company_ssic_cache.json
# ACRA_LIVE_LOOKUP=0
# ACRA_LIVE_LOOKUP_MIN_INTERVAL_SECONDS=2.6
