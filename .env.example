# Database (SQLite for local, PostgreSQL on Railway)
DATABASE_URL=sqlite:///./jobhunter.db

# JWT Secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-random-secret-in-production

# Server
PORT=8000

# CORS (comma-separated origins — never use * in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication. Verified email/password accounts are the default.
# Set cloudflare explicitly to use validated Cloudflare Access instead.
# AUTH_MODE=password
# AUTH_MODE=cloudflare
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-audience-tag
# CF_ACCESS_LOGIN_URL=https://job.example.com
# CF_ACCESS_LOGOUT_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/logout

# Optional external MCP endpoint. It stays disabled until a key is configured.
# MCP_API_KEY=generate-a-long-random-secret
# MCP_REQUESTS_PER_MINUTE=60

# Allowed email domains for password signup (`*` = open signup)
ALLOWED_EMAIL_DOMAINS=*

# Admin account (auto-created on startup if set)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# Contact email shown in privacy notice
# CONTACT_EMAIL=support@jobhuntersg.com

# Matched job alert emails (scheduled command: python send_job_alerts.py)
# APP_BASE_URL=https://job.kooexperience.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=jobs@kooexperience.com
# SMTP_PASS=<Google app password or SMTP relay password>
# SMTP_FROM=Job Hunter SG <jobs@kooexperience.com>
# SMTP_REPLY_TO=jobs@kooexperience.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# AI rate limits (per day)
# ANONYMOUS_AI_PER_DAY=3
# ACCOUNT_AI_PER_DAY=500

# Frontend (set for frontend service on Railway)
# VITE_API_URL=https://your-backend.up.railway.app

# SEA-LION AI (free at sea-lion.ai — 10 req/min per key)
# sealion_api=YOUR_KEY
# sealion_api2=YOUR_KEY2

# SSG Skills Framework (register at developer.ssg-wsg.sg)
# skillsfuture_clientid=YOUR_CLIENT_ID
# skillsfuture_secret=YOUR_SECRET

# Adzuna API (free tier at developer.adzuna.com)
# ADZUNA_APP_ID=your_app_id
# ADZUNA_APP_KEY=your_app_key

# Jooble API (free at jooble.org/api/about)
# JOOBLE_API_KEY=your_api_key

# Public listings hide older cached postings by default.
# PUBLIC_JOB_MAX_AGE_DAYS=60

# ACRA SSIC company taxonomy. Keep user-facing searches cache-only.
# COMPANY_SSIC_CACHE_PATH=/absolute/path/company_ssic_cache.json
# ACRA_LIVE_LOOKUP=0
# ACRA_LIVE_LOOKUP_MIN_INTERVAL_SECONDS=2.6
