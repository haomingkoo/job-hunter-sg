# Database (SQLite for local, PostgreSQL on Railway)
DATABASE_URL=sqlite:///./jobhunter.db

# JWT Secret (generate a random string for production)
JWT_SECRET=change-me-to-a-random-secret-in-production

# Server
PORT=8000

# CORS (comma-separated origins — never use * in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# LinkedIn Scraper (optional — needs playwright + session)
# LINKEDIN_SESSION_PATH=./session.json
